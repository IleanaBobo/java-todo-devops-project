pipeline {
agent any

stages {

    stage('Choose Action') {
        steps {
            script {
                env.ACTION = input(
                    message: 'Select Terraform action:',
                    parameters: [
                        choice(
                            name: 'ACTION',
                            choices: ['apply', 'destroy'],
                            description: 'Choose apply to provision infrastructure or destroy to remove it'
                        )
                    ]
                )
            }
        }
    }

    stage('Checkout') {
        steps {
            git branch: 'main',
            credentialsId: 'github-token',
            url: 'https://github.com/IleanaBobo/java-todo-devops-project.git'
        }
    }

    stage('Terraform Init') {
        steps {
            withCredentials([
                string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
                string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
            ]) {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }
    }

    stage('Terraform Plan') {
        when {
            expression { env.ACTION == 'apply' }
        }

        steps {
            withCredentials([
                string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
                string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
            ]) {
                dir('terraform') {
                    sh 'terraform plan -out=tfplan'
                }
            }
        }
    }

    stage('Approval') {
        when {
            expression { env.ACTION == 'apply' }
        }

        steps {
            input 'Proceed with Terraform Apply and Production Deployment?'
        }
    }

    stage('Terraform Apply') {
        when {
            expression { env.ACTION == 'apply' }
        }

        steps {
            withCredentials([
                string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
                string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
            ]) {
                dir('terraform') {
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }
    }

    stage('Build') {
        when {
            expression { env.ACTION == 'apply' }
        }

        steps {
            dir('app') {
                sh 'mvn clean package'
            }
        }
    }

    stage('Test') {
        when {
            expression { env.ACTION == 'apply' }
        }

        steps {
            dir('app') {
                sh 'mvn test'
            }
        }
    }

    stage('Docker Build') {
        when {
            expression { env.ACTION == 'apply' }
        }

        steps {
            dir('app') {
                sh 'docker build -t ileanaboboescu07/java-todo-devops:prod-v1 .'
            }
        }
    }

    stage('Docker Push') {
        when {
            expression { env.ACTION == 'apply' }
        }

        steps {
            dir('app') {
                sh 'docker push ileanaboboescu07/java-todo-devops:prod-v1'
            }
        }
    }

    stage('Deploy PROD') {
        when {
            expression { env.ACTION == 'apply' }
        }

        steps {
            sh 'ansible-playbook ansible/deploy-prod.yml -i ansible/inventory.ini'
        }
    }

    stage('Terraform Destroy') {
        when {
            expression { env.ACTION == 'destroy' }
        }

        steps {
            withCredentials([
                string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
                string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
            ]) {
                dir('terraform') {
                    sh 'terraform destroy -auto-approve'
                }
            }
        }
    }
}

}
